# Copy to .env.local for local bundle building. NEVER commit .env.local.
# Base64-encoded PKCS8 DER of the Ed25519 bundle-signing private key.
# Generated by: npm run genkey
BUNDLE_SIGNING_PRIVATE_KEY_B64=

# Optional production report storage (Vercel KV / Upstash Redis REST).
# If unset, the local-file store is used (local dev only; ephemeral on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=
